{
  "name": "kouchou-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:e2e": "pnpm --filter @kouchou-ai/e2e-tests test",
    "test:e2e:ui": "pnpm --filter @kouchou-ai/e2e-tests test:ui",
    "test:e2e:report": "pnpm --filter @kouchou-ai/e2e-tests report",
    "build:packages": "pnpm --filter './packages/*' build",
    "clean": "pnpm -r exec rm -rf node_modules dist .next"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.56.0",
    "lefthook": "^1.11.8"
  },
  "dependencies": {
    "@next/third-parties": "^15.2.4"
  },
  "pnpm": {
    "overrides": {
      "@tootallnate/once": "2.0.1",
      "brace-expansion": "5.0.6",
      "diff": "4.0.4",
      "follow-redirects": "1.16.0",
      "lodash": "4.18.1",
      "minimatch": "10.2.5",
      "path-to-regexp": "8.4.2",
      "picomatch": "2.3.2",
      "postcss": "8.5.15",
      "qs": "6.15.2",
      "ws": "8.21.0",
      "yaml": "1.10.3"
    }
  }
}
